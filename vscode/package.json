{
  "name": "atacama-theme",
  "displayName": "Atacama Theme",
  "description": "Tema oscuro y claro con la paleta del desierto de Atacama: azul profundo y amarillo de acento. Colores, íconos de archivo e íconos del producto.",
  "version": "1.0.0",
  "publisher": "commenteme",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#005278",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/commentemeapp/atacama-theme.git",
    "directory": "vscode"
  },
  "homepage": "https://github.com/commentemeapp/atacama-theme/tree/main/vscode#readme",
  "bugs": {
    "url": "https://github.com/commentemeapp/atacama-theme/issues"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "atacama",
    "theme",
    "dark theme",
    "light theme",
    "icon theme",
    "product icon theme",
    "blue",
    "yellow",
    "vtex",
    "shopify",
    "adobe commerce"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Atacama Noche",
        "uiTheme": "vs-dark",
        "path": "./themes/atacama-noche-color-theme.json"
      },
      {
        "label": "Atacama Día",
        "uiTheme": "vs",
        "path": "./themes/atacama-dia-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "atacama-icons",
        "label": "Atacama Icons",
        "path": "./fileicons/commente-file-icon-theme.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "atacama-product-icons",
        "label": "Atacama Product Icons",
        "path": "./product-icons/commente-product-icon-theme.json"
      }
    ]
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "build:icons": "mkdir -p product-icons/fixed && oslllo-svg-fixer -s product-icons/src -d product-icons/fixed && fantasticon",
    "vscode:prepublish": "npm run check && npm run build:icons",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/commentemeapp/atacama-theme/blob/main/vscode --baseImagesUrl https://raw.githubusercontent.com/commentemeapp/atacama-theme/main/vscode",
    "publish:vsce": "vsce publish --no-dependencies --baseContentUrl https://github.com/commentemeapp/atacama-theme/blob/main/vscode --baseImagesUrl https://raw.githubusercontent.com/commentemeapp/atacama-theme/main/vscode",
    "publish:ovsx": "ovsx publish --no-dependencies --baseContentUrl https://github.com/commentemeapp/atacama-theme/blob/main/vscode --baseImagesUrl https://raw.githubusercontent.com/commentemeapp/atacama-theme/main/vscode"
  },
  "devDependencies": {
    "fantasticon": "^3.0.0",
    "oslllo-svg-fixer": "^5.0.0",
    "@vscode/vsce": "^3.0.0",
    "ovsx": "^0.10.0"
  }
}
