  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5C6D75",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#005278"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#5C6D75"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#8A5A00"
      }
    },
    {
      "name": "Property / key",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key",
        "variable.other.property",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "entity.other.attribute-name",
        "entity.name.tag",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#1F6F96"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#1F7A5C"
      }
    },
    {
      "name": "Type / class / component",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "support.class.component",
        "entity.name.tag.tsx support.class.component"
      ],
      "settings": {
        "foreground": "#B3123F"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#6A4BC4"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#1A1A1A"
      }
    },
    {
      "name": "Regexp / escape",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#1F7A5C"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#B3123F",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#005278",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#1F6F96"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#8A5A00"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#3F7A1F"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#B3123F"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#005278"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#1F7A5C",
    "method": "#1F7A5C",
    "type": "#B3123F",
    "class": "#B3123F",
    "interface": "#B3123F",
    "enumMember": "#6A4BC4",
    "property": "#1F6F96",
    "parameter": "#1A1A1A",
    "variable": "#1A1A1A",
    "variable.readonly": "#1A1A1A",
    "namespace": "#B3123F"
  }
}