  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6F8692",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#FFBD38"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#8FA3AE"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#E9D7AC"
      }
    },
    {
      "name": "Property / key",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key",
        "variable.other.property",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "entity.other.attribute-name",
        "entity.name.tag",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#7FBBD8"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#B5E3C9"
      }
    },
    {
      "name": "Type / class / component",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "support.class.component",
        "entity.name.tag.tsx support.class.component"
      ],
      "settings": {
        "foreground": "#F7A1B8"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#C9B6FF"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#DDE4E8"
      }
    },
    {
      "name": "Regexp / escape",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#B5E3C9"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF5C86",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#FFBD38",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7FBBD8"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#E9D7AC"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#95BF47"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF5C86"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FFBD38"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#B5E3C9",
    "method": "#B5E3C9",
    "type": "#F7A1B8",
    "class": "#F7A1B8",
    "interface": "#F7A1B8",
    "enumMember": "#C9B6FF",
    "property": "#7FBBD8",
    "parameter": "#DDE4E8",
    "variable": "#DDE4E8",
    "variable.readonly": "#DDE4E8",
    "namespace": "#F7A1B8"
  }
}